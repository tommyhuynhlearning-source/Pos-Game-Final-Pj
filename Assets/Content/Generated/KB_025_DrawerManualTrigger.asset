  m_Script: {fileID: 11500000, guid: c9f2e8e5b57bd4bd99f33dd56077c2d1, type: 3}
  m_Name: KB_025_DrawerManualTrigger
  m_EditorClassIdentifier: POSTechSupport::POSTechSupport.Data.KnowledgeArticleSO
  articleId: KB-025
  title: Drawer stopped opening by itself
  category: 5
  content: "'Has to be opened by hand now' is different from 'won't open at all'.
    The drawer works \u2014 it is just no longer being told to open when a receipt
    prints, because its trigger mode was changed to Manual.\nSet the trigger back
    to open-on-print. Check the port assignment while you are there, but a conflict
    (KB-003) breaks it entirely rather than turning it into a button."
  relatedErrorCodes: []
  guidanceForIssueIds:
  - P25

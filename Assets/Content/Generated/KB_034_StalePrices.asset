  m_Script: {fileID: 11500000, guid: c9f2e8e5b57bd4bd99f33dd56077c2d1, type: 3}
  m_Name: KB_034_StalePrices
  m_EditorClassIdentifier: POSTechSupport::POSTechSupport.Data.KnowledgeArticleSO
  articleId: KB-034
  title: Register is ringing up old prices
  category: 1
  content: "Prices come down from head office on a schedule. When the register is
    consistently a set behind, the sync stopped running \u2014 not the connection,
    the job. A live connection and a stale price list sit together quite happily.\nForce
    a re-sync from POS Manager. Then ask when they last saw prices update: if the
    answer is 'never', the schedule was never set up and this will come back."
  relatedErrorCodes: []
  guidanceForIssueIds:
  - P34

  m_Script: {fileID: 11500000, guid: c9f2e8e5b57bd4bd99f33dd56077c2d1, type: 3}
  m_Name: KB_032_BatchSettleFailed
  m_EditorClassIdentifier: POSTechSupport::POSTechSupport.Data.KnowledgeArticleSO
  articleId: KB-032
  title: Last night's takings never landed
  category: 1
  content: "Authorization and settlement are two separate events. Cards can approve
    perfectly all evening and the settlement run that actually moves the money can
    still fail at close \u2014 the transactions exist, they were simply never submitted.\nCheck
    the batch state and re-submit the failed batch. Distinguish this from training
    mode (KB-029), where the transactions never existed in the first place."
  relatedErrorCodes: []
  guidanceForIssueIds:
  - P32

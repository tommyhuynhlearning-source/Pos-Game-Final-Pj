  m_Script: {fileID: 11500000, guid: c9f2e8e5b57bd4bd99f33dd56077c2d1, type: 3}
  m_Name: KB_031_PosOfflineMode
  m_EditorClassIdentifier: POSTechSupport::POSTechSupport.Data.KnowledgeArticleSO
  articleId: KB-031
  title: Sales work but reports are empty
  category: 1
  content: "Offline mode is store-and-forward: the POS keeps taking sales and holds
    them locally. Staff see nothing wrong, which is why this is usually reported
    days late as a reporting problem.\nConfirm the network is actually healthy first
    \u2014 if it is, the POS went offline and stayed there rather than being pushed.
    Bring it back online and let the queue upload before you hang up."
  relatedErrorCodes: []
  guidanceForIssueIds:
  - P31

  m_Script: {fileID: 11500000, guid: c9f2e8e5b57bd4bd99f33dd56077c2d1, type: 3}
  m_Name: KB_015_PendingReboot
  m_EditorClassIdentifier: POSTechSupport::POSTechSupport.Data.KnowledgeArticleSO
  articleId: KB-015
  title: Machine is nagging about an update
  category: 3
  content: "A staged update holds services in a half-applied state: the install finished,
    the restart didn't. Until it reboots, the machine reports Blocked all the way
    down.\nRestarting is the fix, but it is disruptive \u2014 it drops your remote
    session and takes the register offline for a few minutes. Tell the customer before
    you do it, and check the batch first: settle it or make sure they know what is
    still open."
  relatedErrorCodes: []
  guidanceForIssueIds:
  - P15

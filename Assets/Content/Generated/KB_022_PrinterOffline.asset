  m_Script: {fileID: 11500000, guid: c9f2e8e5b57bd4bd99f33dd56077c2d1, type: 3}
  m_Name: KB_022_PrinterOffline
  m_EditorClassIdentifier: POSTechSupport::POSTechSupport.Data.KnowledgeArticleSO
  articleId: KB-022
  title: '"Printer offline" with the printer sitting right there'
  category: 2
  content: "'Use Printer Offline' is a checkbox someone ticked, not a fault the printer
    developed. The driver is healthy and the device is present \u2014 nothing needs
    reinstalling (KB-002) and nothing needs unplugging (KB-018).\nUntick it in the
    device's menu and print a test page. If it re-ticks itself later, that is a genuine
    connectivity problem underneath and you are back to the cable."
  relatedErrorCodes: []
  guidanceForIssueIds:
  - P22
